	(text_box "ESTOP Gates all subsystems.\nOn RP2350 Boot, if ESTOP is not pressed, each reserved GPIO can bring up a subsystem.\n\nIf ESTOP is pressed, only Jetson, Network Switch, Comms and RP2350 stay up. \nThis is for telemetry gathering so we dont have a full black out."
		(exclude_from_sim no)
		(at 30.48 50.8 0)
		(size 30.48 26.4392)
		(margins 0.9525 0.9525 0.9525 0.9525)
