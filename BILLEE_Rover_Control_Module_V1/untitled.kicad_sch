	(text_box "I2C ADDRESS MAPPING\nI2C0	INA780x DRIVE1	0x40	A1=GND, A0=GND\nI2C0	INA780x DRIVE2	0x41	A1=GND, A0=VS\nI2C0	INA780x DRIVE3	0x43	A1=GND, A0=SCL\nI2C0	INA780x DRIVE4	0x44	A1=VS, A0=GND\nI2C0	INA780x DRIVE5	0x45	A1=VS, A0=VS\nI2C0	INA780x DRIVE6	0x47	A1=VS, A0=SCL\nI2C0	INA780x ARM	0x4C	A1=SCL, A0=GND\nI2C0	INA780x SCIENCE	0x4D	A1=SCL, A0=VS\nI2C0	INA780x LOGIC	0x4F	A1=SCL, A0=SCL\nI2C1	MCP9808 LOGIC_TEMP	0x18	A2=0, A1=0, A0=0\nI2C1	MCP9808 DRIVE_TEMP		0x19	A2=0, A1=0, A0=1\nI2C1	MCP9808 ARM_SCI_TEMP	0x1A	A2=0, A1=1, A0=0\n"
